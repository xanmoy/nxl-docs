---
import { ArrowRight, MoveUpRight, Code2, Cpu, BookOpen } from "@lucide/astro";
---

<div class="nxl-home">
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="eyebrow">
        <span class="status-dot"></span>
        An experimental programming language
      </div>

      <h1>NXL</h1>

      <p class="hero-title">
        Simple. Expressive.<br />
        <span>Built from scratch.</span>
      </p>

      <p class="hero-description">
        A programming language designed for readable code, explicit blocks, and
        a simple learning curve — built from scratch in Rust.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="/getting-started/introduction/">
          Get Started
          <span><ArrowRight size={20} /></span>
        </a>

        <a
          class="button button-secondary"
          href="https://github.com/xanmoy/nxl"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
          <svg
            width="18"
            height="18"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="code-window">
      <div class="window-header">
        <div class="window-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <span class="filename">hello.nxl</span>

        <button class="copy-button" type="button" data-copy-target="hello-code">
          <svg
            width="13"
            height="13"
            viewBox="0 0 16 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect
              x="5.5"
              y="5.5"
              width="8.5"
              height="8.5"
              rx="1.5"
              stroke="currentColor"
              stroke-width="1.2"></rect>
            <path
              d="M3.5 10.5H2.75C2.05964 10.5 1.5 9.94036 1.5 9.25V2.75C1.5 2.05964 2.05964 1.5 2.75 1.5H9.25C9.94036 1.5 10.5 2.05964 10.5 2.75V3.5"
              stroke="currentColor"
              stroke-width="1.2"></path>
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <pre><code id="hello-code"><span class="keyword">let</span> name = <span class="string">"NXL"</span>
<span class="keyword">let</span> age = <span class="number">23</span>

<span class="keyword">if</span> age &gt;= <span class="number">18</span> &lbrace;
    <span class="function">print</span>(<span class="string">"Hello, "</span> + name)
&rbrace;</code></pre>
    </div>
  </section>

  <section class="section why reveal">
    <div class="section-heading">
      <span class="section-label">01</span>
      <h2>Why NXL?</h2>
      <p>
        NXL explores what a simple, understandable programming language can look
        like when built from the ground up.
      </p>
    </div>

    <div class="feature-grid">
      <article class="feature">
        <div class="feature-number">01</div>
        <h3>Simple syntax</h3>
        <p>
          Familiar syntax designed to keep programs readable without adding
          unnecessary complexity.
        </p>
      </article>

      <article class="feature">
        <div class="feature-number">02</div>
        <h3>Explicit blocks</h3>
        <p>
          NXL uses <code>&#123;&#125;</code> to define blocks instead of relying on
          indentation.
        </p>

        <pre
          class="mini-code"><code><span class="keyword">if</span> condition &#123;
    <span class="function">print</span>(<span class="string">"Hello"</span>)
&#125;</code></pre>
      </article>

      <article class="feature">
        <div class="feature-number">03</div>
        <h3>Built in Rust</h3>
        <p>
          The compiler and runtime are being developed from scratch in Rust,
          making the implementation part of the learning experience.
        </p>
      </article>
    </div>
  </section>

<section class="section pipeline-section reveal">
  <div class="section-heading centered">
    <span class="section-label">02</span>
    <h2>How NXL works</h2>
    <p>
      Follow the journey from source code to execution.
    </p>
  </div>

  <ol class="pipeline">
    <li class="pipeline-item">
      <span class="pipeline-index">01</span>
      <div class="pipeline-body">
        <strong>Source</strong>
        <small>Your NXL program</small>
      </div>
    </li>

    <li class="pipeline-item">
      <span class="pipeline-index">02</span>
      <div class="pipeline-body">
        <strong>Lexer</strong>
        <small>Characters → tokens</small>
      </div>
    </li>

    <li class="pipeline-item">
      <span class="pipeline-index">03</span>
      <div class="pipeline-body">
        <strong>Parser</strong>
        <small>Tokens → structure</small>
      </div>
    </li>

    <li class="pipeline-item">
      <span class="pipeline-index">04</span>
      <div class="pipeline-body">
        <strong>AST</strong>
        <small>Program representation</small>
      </div>
    </li>

    <li class="pipeline-item">
      <span class="pipeline-index">05</span>
      <div class="pipeline-body">
        <strong>Interpreter</strong>
        <small>Execute the program</small>
      </div>
    </li>
  </ol>
</section>

  <section class="section install-section reveal">
    <div class="section-heading">
      <span class="section-label">03</span>
      <h2>Try it in a minute</h2>
      <p>
        No package manager, no build step to configure. Clone the repo and run
        your first program with Cargo.
      </p>
    </div>

    <div class="code-window terminal-window">
      <div class="window-header">
        <div class="window-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <span class="filename">terminal</span>

        <button
          class="copy-button"
          type="button"
          data-copy-target="install-code"
        >
          <svg
            width="13"
            height="13"
            viewBox="0 0 16 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect
              x="5.5"
              y="5.5"
              width="8.5"
              height="8.5"
              rx="1.5"
              stroke="currentColor"
              stroke-width="1.2"></rect>
            <path
              d="M3.5 10.5H2.75C2.05964 10.5 1.5 9.94036 1.5 9.25V2.75C1.5 2.05964 2.05964 1.5 2.75 1.5H9.25C9.94036 1.5 10.5 2.05964 10.5 2.75V3.5"
              stroke="currentColor"
              stroke-width="1.2"></path>
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <pre><code id="install-code"><span class="prompt">$</span> git clone https://github.com/xanmoy/nxl
<span class="prompt">$</span> <span class="keyword">cd</span> nxl
<span class="prompt">$</span> cargo run -- hello.nxl</code></pre>
    </div>
  </section>

  <section class="section learn-section reveal">
    <div class="section-heading">
      <span class="section-label">04</span>
      <h2>Learn NXL</h2>
      <p>
        Learn the language from your first program all the way down to its
        internals.
      </p>
    </div>

    <div class="learn-grid">
      <a class="learn-card" href="/getting-started/introduction/">
        <span class="card-icon">
            <Code2 size={20} />
        </span>
        <div>
          <span class="card-label">START HERE</span>
          <h3>Getting Started</h3>
          <p>Install NXL and write your first program.</p>
        </div>
        <span class="card-arrow"><MoveUpRight size={20} /></span>
      </a>

      <a class="learn-card" href="/language/syntax/">
        <span class="card-icon"><BookOpen size={20} ></BookOpen></span>
        <div>
          <span class="card-label">LANGUAGE</span>
          <h3>Language Guide</h3>
          <p>Learn syntax, types, operators, and functions.</p>
        </div>
        <span class="card-arrow"><MoveUpRight size={20} /></span>
      </a>

      <a class="learn-card" href="/internals/architecture/">
        <span class="card-icon"><Cpu size={20} ></Cpu></span>
        <div>
          <span class="card-label">UNDER THE HOOD</span>
          <h3>Internals</h3>
          <p>Explore the lexer, parser, AST, runtime, and interpreter.</p>
        </div>
        <span class="card-arrow"><MoveUpRight size={20} /></span>
      </a>
    </div>
  </section>

 <section class="section open-source reveal">
    <div class="open-source-box">
      <span class="section-label">05</span>

      <h2>Built in the open.</h2>

      <p>
        NXL is an open-source experiment in programming language design,
        compiler construction, and learning by building.
      </p>

      <div class="open-source-actions">
        <a
          class="button button-primary"
          href="https://github.com/xanmoy/nxl"
          target="_blank"
          rel="noopener noreferrer"
        >
          Explore the repository
          <span><MoveUpRight size={20} /></span>
        </a>

        <a class="text-link" href="/contributing/development/">
          Contribute to NXL
          <span><ArrowRight size={16} /></span>
        </a>
      </div>
    </div>
  </section>
</div>

<footer class="nxl-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <span class="footer-logo">NXL</span>
      <p>
        An experimental programming language built from scratch in Rust — simple
        syntax, explicit blocks, and a compiler you can read top to bottom.
      </p>

      <a
        class="footer-github"
        href="https://github.com/xanmoy/nxl"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="NXL on GitHub"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <span class="footer-col-title">Learn</span>
        <a href="/getting-started/introduction/">Getting Started</a>
        <a href="/language/syntax/">Language Guide</a>
        <a href="/internals/architecture/">Internals</a>
      </div>

      <div class="footer-col">
        <span class="footer-col-title">Project</span>
        <a
          href="https://github.com/xanmoy/nxl"
          target="_blank"
          rel="noopener noreferrer">Repository</a
        >
        <a href="/contributing/development/">Contributing</a>
        <a
          href="https://github.com/xanmoy/nxl/issues"
          target="_blank"
          rel="noopener noreferrer">Report an Issue</a
        >
      </div>

      <div class="footer-col">
        <span class="footer-col-title">Source</span>
        <a
          href="https://github.com/xanmoy/nxl"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <span
      >© <span id="footer-year">2026</span> NXL. Source available on GitHub.</span
    >
    <span class="footer-tagline">Built from scratch, one token at a time.</span>
  </div>
</footer>

<style is:global>
  /*
    Starlight always renders its own <h1 id="_top"> page title via the
    PageTitle component, regardless of `template: splash` — splash only
    removes the sidebar/TOC, not the title. That auto-title duplicates
    the "NXL" heading in our custom hero below, so hide it specifically
    on pages that contain this component.
  */
  body:has(.nxl-home) h1#_top {
    display: none;
  }

  /*
    Starlight's page wrapper still reserves padding/margin for the
    space where the title used to sit, even once it's hidden above.
    That stacks on top of our hero's own padding and creates a large
    empty gap under the header. Zero it out on this page only.
  */
  body:has(.nxl-home) .content-panel {
    padding: 0;
  }

  body:has(.nxl-home) .sl-markdown-content {
    margin: 0;
  }

  body:has(.nxl-home) .sl-markdown-content > :first-child {
    margin-top: 0;
  }
</style>

<style>
  .nxl-home {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .hero {
    position: relative;
    min-height: 720px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 7rem 0 6rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -12rem;
    left: 50%;
    width: 62rem;
    height: 34rem;
    transform: translateX(-50%);
    pointer-events: none;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--sl-color-accent) 16%, transparent),
      transparent 70%
    );
    filter: blur(10px);
    z-index: 0;
  }

  .hero-content,
  .code-window {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 820px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
    margin-bottom: 2rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #7dd3a8;
    box-shadow: 0 0 12px #7dd3a8;
    animation: pulse 2.4s ease-in-out infinite;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(4.5rem, 13vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.08em;
    font-weight: 800;
    color: var(--sl-color-white);
  }

  .hero-title {
    margin: 2rem 0 1.25rem;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .hero-title span {
    color: var(--sl-color-accent-high);
  }

  .hero-description {
    max-width: 680px;
    margin: 0 auto;
    color: var(--sl-color-gray-2);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.2rem;
    border-radius: 0.65rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 150ms ease,
      border-color 150ms ease,
      background 150ms ease,
      box-shadow 150ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--sl-color-accent-high);
    color: var(--sl-color-black);
  }

  .button-primary:hover {
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--sl-color-accent-high) 60%, transparent);
  }

  .button-secondary {
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-white);
    background: var(--sl-color-gray-7);
  }

  .button-secondary:hover {
    border-color: var(--sl-color-accent);
  }

  .code-window {
    width: min(760px, 100%);
    margin-top: 4.5rem;
    overflow: hidden;
    text-align: left;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.9rem;
    background: #15171d;
    box-shadow: 0 30px 80px rgb(0 0 0 / 30%);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .code-window:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
  }

  .terminal-window {
    margin-top: 0;
    width: 100%;
  }

  .window-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: #1c1f27;
  }

  .window-dots {
    display: flex;
    gap: 0.4rem;
  }

  .window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
  }

  .filename {
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    font-family: var(--sl-font-mono);
    flex: 1;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
  }

  .copy-button:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
  }

  .copy-button.copied {
    color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }

  .code-window pre {
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
    background: transparent;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .keyword {
    color: #c4a7ff;
  }

  .string {
    color: #9dd7a5;
  }

  .number {
    color: #f2c68a;
  }

  .function {
    color: #8ec9ff;
  }

  .prompt {
    color: var(--sl-color-accent-high);
    user-select: none;
    margin-right: 0.3em;
  }

  .section {
    padding: 7rem 0;
  }

  .install-section {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .section-heading {
    max-width: 680px;
    margin-bottom: 3rem;
  }

  .section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-label {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--sl-color-accent-high);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .section-heading h2,
  .open-source-box h2 {
    margin: 0 0 1rem;
    color: var(--sl-color-white);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
  }

  .section-heading p,
  .open-source-box p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .feature {
    padding: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.9rem;
    background: color-mix(
      in srgb,
      var(--sl-color-gray-6) 45%,
      transparent
    );
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .feature:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--sl-color-accent) 50%, var(--sl-color-gray-5));
    background: color-mix(in srgb, var(--sl-color-gray-6) 65%, transparent);
  }

  .feature-number {
    margin-bottom: 2.5rem;
    color: var(--sl-color-accent-high);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  .feature h3 {
    margin: 0 0 0.75rem;
    color: var(--sl-color-white);
    font-size: 1.3rem;
  }

  .feature p {
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.7;
  }

  .feature code {
    padding: 0.15rem 0.35rem;
    border-radius: 0.3rem;
  }

  .mini-code {
    margin: 1.5rem 0 0;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: #15171d;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .pipeline {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .pipeline-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 165px;
    padding: 0 0.5rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 500ms ease, transform 500ms ease;
  }

